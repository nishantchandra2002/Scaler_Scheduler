{
  "manifest_version": 3,
  "name": "Scaler Class Scheduler",
  "version": "1.0.6",
  "description": "Bulk-schedule classes batch by batch on Scaler SCM from a CSV.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.scaler.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.scaler.com/scm/classes/schedule-classes*"],
      "js": ["content/page-world.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.scaler.com/scm/classes/schedule-classes*"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ]
}
